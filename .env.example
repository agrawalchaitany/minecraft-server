# Copy to .env and edit: cp .env.example .env

# You must accept the Minecraft EULA: https://aka.ms/MinecraftEULA
EULA=false

# Used internally for graceful shutdown and backups (RCON is never published to the host).
# Leave empty to have a random one generated and stored in the server's data volume.
RCON_PASSWORD=

# --- Version ---
# Minecraft version to run: "latest" (newest stable) or any version from `make versions`, e.g. 1.21.4.
# Choose it before the first `make up`: worlds can be upgraded later, but never downgraded.
MC_VERSION=latest
PAPER_BUILD=latest
# Java is picked automatically for the Minecraft version (17, 21 or 25). Only set this to override.
# JAVA_VERSION=21
# Refuse to open a world in an older Minecraft version than it was last run on (prevents corruption).
ALLOW_DOWNGRADE=false

# --- Resources ---
# JVM heap. CONTAINER_MEMORY should be roughly MEMORY + 1G for JVM overhead.
MEMORY=2G
CONTAINER_MEMORY=3G
# Extra JVM flags, appended last.
JVM_OPTS=

# --- Network ---
SERVER_PORT=25565

# --- Gameplay (leave empty to keep whatever is in server.properties) ---
MOTD=A reliable Paper server
MAX_PLAYERS=20
DIFFICULTY=normal
GAMEMODE=survival
# true  = only players with an official Minecraft account can join (verified with Mojang).
# false = anyone can join with any username (no account needed). Usernames are NOT verified,
#         so anyone could join as an admin's name; see docs/offline-mode.md.
ONLINE_MODE=true
# In offline mode, apply Mojang's username rules: 3-16 characters, letters/numbers/_ only,
# and unique ignoring case (no "Steve" and "steve"). Has no effect in online mode.
ENFORCE_USERNAME_RULES=true
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
LEVEL_NAME=world
SEED=
PVP=true
WHITELIST=false

# When ONLINE_MODE changes, move each player's inventory/progress to their id in the new mode
# (a backup is taken first). Needs internet access to Mojang when switching to online mode.
MIGRATE_PLAYER_DATA=true

# --- Plugins (see plugins/plugins.txt) ---
# Check for plugin updates every day at PLUGIN_UPDATE_TIME. If there are any, players get a
# 5-minute warning, a backup is taken, and the server restarts to apply them.
PLUGIN_AUTO_UPDATE=false
PLUGIN_UPDATE_TIME=04:00
# Timezone for PLUGIN_UPDATE_TIME and log timestamps, e.g. Asia/Kolkata, Europe/London
TZ=UTC

# --- Backups ---
# Any `sleep` duration: 30m, 1h, 6h, 1d
BACKUP_INTERVAL=1h
BACKUP_KEEP=24

# --- Reliability ---
# How long to wait for worlds to save on shutdown before Docker force-kills the server.
STOP_TIMEOUT=2m
# Kill and restart the server after WATCHDOG_FAILURES failed pings, WATCHDOG_INTERVAL seconds apart. 0 disables.
WATCHDOG_INTERVAL=60
WATCHDOG_FAILURES=5

# --- File ownership for ./backups on Linux hosts (run `id -u` / `id -g`) ---
PUID=1000
PGID=1000
