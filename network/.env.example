# Copy to .env and edit: cp .env.example .env
# These settings are shared by every server in the network. Per-server gameplay (difficulty, PvP, game mode)
# is in compose.yaml under each server's `environment:`.

# You must accept the Minecraft EULA: https://aka.ms/MinecraftEULA
EULA=false

# --- Version (every server runs the same one; players on other versions join through ViaVersion) ---
# "latest" (newest stable) or any version from `make versions`. Worlds can be upgraded later, never downgraded.
MC_VERSION=latest
PAPER_BUILD=latest
# Velocity proxy version: "latest" or e.g. 4.3.1
VELOCITY_VERSION=latest

# Shared secret that proves to each server that a login came through the proxy.
# Leave empty: `make up` generates one. Changing it requires restarting every server.
PROXY_SECRET=

# --- Proxy ---
SERVER_PORT=25565
# Server list message, in MiniMessage format (https://docs.advntr.dev/minimessage/format)
PROXY_MOTD=<gradient:#55ffff:#aa55ff><bold>My Network</bold></gradient><newline><gray>Survival - BedWars - SkyWars - KitPvP - Racing
MAX_PLAYERS=100
# false = cracked and premium players (the VeloAuth plugin handles logins); true = premium accounts only.
PROXY_ONLINE_MODE=false

# --- RAM per container. The Java heap is sized to fit automatically. ---
# Docker Desktop: Settings > Resources > Memory must cover everything that is switched on.
# Always on: proxy + limbo + lobby = about 3.3G.
PROXY_RAM=768M
LIMBO_RAM=1G
LOBBY_RAM=1536M
SURVIVAL_RAM=2560M
BEDWARS_RAM=2G
SKYWARS_RAM=2G
KITPVP_RAM=2G
RACING_RAM=2G
ANARCHY_RAM=2560M

# --- Shared gameplay ---
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
WHITELIST=false

# --- Plugins (servers/<id>/plugins.txt, proxy/plugins.txt) ---
PLUGIN_AUTO_UPDATE=false
PLUGIN_UPDATE_TIME=04:00
# Timezone for PLUGIN_UPDATE_TIME and log timestamps, e.g. Asia/Kolkata
TZ=UTC

# --- Backups (each server keeps its own in backups/<id>/) ---
BACKUP_INTERVAL=1h
BACKUP_KEEP=24

# --- Reliability ---
STOP_TIMEOUT=2m
WATCHDOG_INTERVAL=60
WATCHDOG_FAILURES=5

# Internal RCON password; leave empty to give each server its own random one.
RCON_PASSWORD=

PUID=1000
PGID=1000
